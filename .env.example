# Copy this file to .env and insert your real key locally.
# Never commit the .env file.

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

APP_NAME=Enterprise Support RAG Knowledge Assistant
APP_ENV=development
LOG_LEVEL=INFO

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
MAX_QUERY_LENGTH=1000
REQUEST_TIMEOUT_SECONDS=30